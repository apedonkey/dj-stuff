# Proprietary binaries pulled from the headset and anything derived from them in bulk.
# Only notes, scripts, logs, grep hits and text reports are tracked.
pulled/
unpacked/
out/
tools/
obb_raw/
__pycache__/

# Signing key material — never commit
*.keystore
*.jks

# Future binary asset extracts (keep text reports like skeleton.json / *.md / *.txt)
extracted/assets/
*.glb
*.fbx
*.pak
*.uasset
*.uexp
